
@rendermode InteractiveServer
@inject NavBarContainer container
<div class="top-row navbar navbar-dark">
    <div class="h-100 navbar-brand">
        <button class="navbar-brand m-0 p-0" @onclick="container.toggleBar">
                <img class="navbar-brand m-0 p-0" src="assets/icons/menuburger.png" />
            </button>
    </div>
</div>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3" tabindex="0">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <img class="bi" aria-hidden="true" src="assets/icons/home.png" /> Home
            </NavLink>
        </div>
        @* Man this was annoying to write but it's much more efficient and centralized *@
        @foreach (var navigation in container.navigations)
        {
            <NavItem path=@navigation.path name=@navigation.name icoPath=@navigation.icoPath localPath=@navigation.localPath enabled=@navigation.enabled />
        }
    </nav>
</div>